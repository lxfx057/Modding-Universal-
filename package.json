{
  "name": "universal-modding-center",
  "version": "0.1.0",
  "private": true,
  "description": "Universal Modding Center web and desktop companion",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "web": "npx serve site",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.umc.universalmoddingcenter",
    "productName": "Universal Modding Center",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "site/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}